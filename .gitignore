# ZeroShield AI .gitignore

# Python

__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments

.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# Python packaging

build/
dist/
*.egg-info/
.eggs/
*.egg

# Python caches and tools

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.cache/

# Coverage files

.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py.cover

# Environment variables and secrets

.env
.env.*
!.env.example
.envrc

secrets/
credentials/

*.key
*.pem
*.crt
*.p12
*.pfx

.pypirc

# ZeroShield datasets

data/raw/*
data/processed/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Machine learning models and artefacts

models/*

!models/.gitkeep
!models/README.md

*.pkl
*.joblib
*.onnx
*.h5
*.hdf5

# Experiment outputs

experiments/**/outputs/
experiments/**/results/
experiments/**/artifacts/

tmp/
temp/

# Runtime and security logs

logs/*

!logs/.gitkeep

*.log
logs/*.jsonl

# Jupyter and notebooks

.ipynb_checkpoints/
profile_default/
ipython_config.py

# Backend local files

backend/.env

*.sqlite
*.sqlite3
*.sqlite3-journal

# Frontend and Node.js

frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

frontend/.env
frontend/.env.*
!frontend/.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated reports

reports/generated/

# VS Code and IDE files

.vscode/
.idea/

tempCodeRunnerFile.py

# Windows files

Thumbs.db
Desktop.ini

# macOS files

.DS_Store

# Documentation build files

docs/_build/
site/

# Temporary files

*.tmp
*.temp
*.bak
*.swp
*.swo
*~